TELEGRAM_API_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
MCP_SERVER_URL=http://127.0.0.1:8000/mcp
TELEGRAM_ADMIN_IDS=
MCP_AUTH_TOKEN=

# Необязательно. База создаётся при первом запуске сервера.
# DATABASE_PATH=data/services.db

# Необязательно. По умолчанию сервер слушает только localhost.
# Публичный адрес без MCP_AUTH_TOKEN сервер не запустит.
# Для удалённого доступа поставьте HTTPS-прокси и задайте тот же токен в боте.
# MCP_BIND_HOST=127.0.0.1
# MCP_PORT=8000
# MCP_SSL_CERTFILE=
# MCP_SSL_KEYFILE=
